{
  "name": "markdown-to-pdf-app",
  "version": "1.0.0",
  "private": true,
  "description": "Markdown to PDF/Word/HTML converter - Online tool",
  "scripts": {
    "dev": "pnpm --filter @mdpdf/frontend dev",
    "dev:frontend": "pnpm --filter @mdpdf/frontend dev",
    "dev:backend": "pnpm --filter @mdpdf/backend dev",
    "build": "pnpm --filter @mdpdf/frontend build",
    "typecheck": "pnpm --filter @mdpdf/frontend typecheck",
    "lint": "pnpm --filter @mdpdf/frontend lint",
    "build:all": "pnpm -r build",
    "typecheck:all": "pnpm -r typecheck",
    "lint:all": "pnpm -r lint"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "puppeteer",
      "sharp",
      "unrs-resolver"
    ]
  }
}
