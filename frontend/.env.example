# Frontend environment template. Copy to .env.local and fill in real values.
# .env.local is gitignored — never commit secrets.

# Supabase (anon key is safe in browser; never put service_role here)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend API
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Public site URL (used for canonical URLs, OG tags, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
