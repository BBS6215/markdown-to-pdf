# Backend environment template. Copy to .env and fill in real values.
# .env is gitignored — never commit secrets.
# Source: 05-技术方案 附录 C, docs/09-服务端权威用量补丁.md

# Server
ALLOWED_ORIGIN=http://localhost:3000
PORT=4000
NODE_ENV=development

# Puppeteer
# In production (Docker): /usr/bin/chromium-browser or similar system Chromium.
# In dev: leave empty so puppeteer uses its bundled Chrome.
PUPPETEER_EXECUTABLE_PATH=

# Supabase
# URL:                 https://<project-ref>.supabase.co
# Anon key:            used to verify user JWTs via auth.getUser(token).
# Service role key:    bypasses RLS; used by consume_quota / refund_quota /
#                      record_conversion. NEVER expose this key to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
