# Reduce docker build context for `docker build -f backend/Dockerfile .`
# Each entry is matched relative to the build context (monorepo root).

# Workspace node_modules — re-resolved inside the image via pnpm install
node_modules/
**/node_modules/

# Build artefacts
**/dist/
**/.next/
**/out/

# Local env / secrets — keys must be injected at runtime, never baked into the image
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# IDE / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db

# Git
.git/
.gitignore
.gitattributes

# Docs and local research assets are not needed in the image
docs/
SEO情况/
*.md
!backend/README.md

# Frontend is irrelevant to the backend image
frontend/
